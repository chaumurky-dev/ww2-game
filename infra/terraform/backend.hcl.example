# Copy to backend.hcl (gitignored) and run: terraform init -backend-config=backend.hcl
# Create the bucket first with scripts/aws-bootstrap.sh.
bucket       = "wartide-terraform-state-243963726301"
key          = "wartide/prod/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3 native locking (Terraform >= 1.10), no DynamoDB table needed
