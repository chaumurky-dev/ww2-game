env         = "prod"
region      = "us-east-1"
domain_name = "ww2.chaumurky.net"

# Create a hosted zone with apex = domain_name; delegate it with NS records at the parent zone (hosted at DreamHost for chaumurky.net).
create_route53_zone = true
route53_zone_id     = "" # only used when create_route53_zone = false

github_repo                 = "chaumurky-dev/ww2-game"
create_github_oidc_provider = false # the account already has it

# This org uses GitHub's immutable OIDC subject (owner/repo ids). See variables.tf.
github_oidc_subjects = [
  "repo:chaumurky-dev@305633583/ww2-game@1432703929:ref:refs/heads/main",
  "repo:chaumurky-dev@305633583/ww2-game@1432703929:environment:production",
]

# Required: budget / anomaly / alarm / account-contact notifications (see guardrails.tf).
alert_email = "you@example.com"
alert_phone = "+10000000000" # replace with a real E.164 number for the account alternate contacts
# monthly_budget_usd = 60
# Reuse the account's existing service anomaly monitor (one per account; see `aws ce get-anomaly-monitors`)
# anomaly_monitor_arn = "arn:aws:ce::123456789012:anomalymonitor/00000000-0000-0000-0000-000000000000"

# Optional: keep the Route53 zone's name servers stable across hibernate/wake. Create the delegation set once
# with `scripts/aws-bootstrap.sh delegation-set` (admin profile) and paste its id here, then point the parent's NS at it.
# route53_delegation_set_id = "N1PA6795SAMPLE"

# Hibernate (hibernate, db_deletion_protection, alb_deletion_protection, secret_recovery_window_days,
# db_skip_final_snapshot, db_final_snapshot_tag) is driven by scripts/aws-hibernate.sh via the gitignored
# hibernate.auto.tfvars; do not set these by hand.
