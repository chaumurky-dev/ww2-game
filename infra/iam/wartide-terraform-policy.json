{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*", "elasticloadbalancing:Describe*", "ecs:Describe*", "ecs:List*",
        "ecr:Describe*", "ecr:List*", "ecr:GetAuthorizationToken", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer",
        "rds:Describe*", "rds:List*", "logs:Describe*", "logs:List*", "logs:Get*",
        "acm:Describe*", "acm:List*", "acm:Get*", "ses:Get*", "ses:List*", "ses:Describe*",
        "route53:Get*", "route53:List*", "route53:TestDNSAnswer",
        "secretsmanager:ListSecrets", "secretsmanager:GetRandomPassword",
        "iam:Get*", "iam:List*", "kms:Describe*", "kms:List*", "application-autoscaling:Describe*",
        "sts:GetCallerIdentity", "s3:ListAllMyBuckets", "s3:GetBucketLocation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RegionalInfrastructure",
      "Effect": "Allow",
      "Action": [
        "ec2:*", "elasticloadbalancing:*", "ecs:*", "ecr:*", "rds:*", "logs:*", "acm:*", "ses:*",
        "application-autoscaling:*"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } }
    },
    {
      "Sid": "Route53",
      "Effect": "Allow",
      "Action": [
        "route53:CreateHostedZone", "route53:DeleteHostedZone", "route53:UpdateHostedZoneComment",
        "route53:ChangeResourceRecordSets", "route53:ChangeTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProjectSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:*",
      "Resource": "arn:aws:secretsmanager:us-east-1:243963726301:secret:wartide-*"
    },
    {
      "Sid": "ProjectIamRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:UpdateRole", "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy", "iam:TagRole", "iam:UntagRole",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:AttachRolePolicy", "iam:DetachRolePolicy",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::243963726301:role/wartide-*"
    },
    {
      "Sid": "ProjectIamUsersAndPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreateUser", "iam:DeleteUser", "iam:TagUser", "iam:UntagUser",
        "iam:PutUserPolicy", "iam:DeleteUserPolicy", "iam:AttachUserPolicy", "iam:DetachUserPolicy",
        "iam:CreateAccessKey", "iam:DeleteAccessKey", "iam:UpdateAccessKey",
        "iam:CreatePolicy", "iam:DeletePolicy", "iam:CreatePolicyVersion", "iam:DeletePolicyVersion",
        "iam:TagPolicy", "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::243963726301:user/wartide-*",
        "arn:aws:iam::243963726301:policy/wartide-*"
      ]
    },
    {
      "Sid": "ServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com", "rds.amazonaws.com", "elasticloadbalancing.amazonaws.com",
            "ecs.application-autoscaling.amazonaws.com", "spot.amazonaws.com", "ses.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "TerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:ListBucket", "s3:GetBucket*", "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration", "s3:PutBucketPublicAccessBlock", "s3:GetEncryptionConfiguration",
        "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::wartide-terraform-state-243963726301",
        "arn:aws:s3:::wartide-terraform-state-243963726301/*"
      ]
    },
    {
      "Sid": "NeverTouchOwnRoleOrAdminPolicies",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": "arn:aws:iam::243963726301:role/wartide-terraform"
    },
    {
      "Sid": "NoAttachingAwsManagedAdmin",
      "Effect": "Deny",
      "Action": ["iam:AttachRolePolicy", "iam:AttachUserPolicy"],
      "Resource": "*",
      "Condition": { "ArnEquals": { "iam:PolicyARN": "arn:aws:iam::aws:policy/AdministratorAccess" } }
    }
  ]
}
