# Copy to .env for local development.
PORT=8080
DATABASE_URL=postgres://wartide:wartide@localhost:5432/wartide
BASE_URL=http://localhost:8080
# Mailpit (web UI at http://localhost:8025). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Wartide <noreply@wartide.local>
# Used to salt session/email token hashes. Set a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-string
WEB_DIST_DIR=crates/web/dist
DEFAULT_TURN_TIMEOUT_SECS=172800
# Set COOKIE_SECURE=false only when serving over plain http to a browser that rejects Secure on localhost (Safari).
COOKIE_SECURE=true
# RATE_LIMIT=false disables auth route rate limiting
RATE_LIMIT=true
RUST_LOG=info,sqlx=warn
